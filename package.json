{
  "name": "vsc-secure-notes",
  "displayName": "Secure Notes (MD)",
  "description": "Encrypt and protect MarkDown notes with a password.",
  "version": "2.2.0",
  "publisher": "cipherswami",
  "icon": "media/logo.png",
  "categories": [
    "Notebooks",
    "Other"
  ],
  "keywords": [
    "Secure Notes",
    "Markdown",
    "security",
    "password",
    "encrypted",
    "AES"
  ],
  "homepage": "https://github.com/cipherswami/vscode-secure-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/cipherswami/vscode-secure-notes.git"
  },
  "bugs": {
    "url": "https://github.com/cipherswami/vscode-secure-notes/issues"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.110.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsc-secure-notes.encrypt",
        "title": "Secure Notes: Encrypt",
        "icon": "$(lock)"
      },
      {
        "command": "vsc-secure-notes.decrypt",
        "title": "Secure Notes: Decrypt",
        "icon": "$(unlock)"
      },
      {
        "command": "vsc-secure-notes.openPreview",
        "title": "Secure Notes: Open Preview"
      }
    ],
    "customEditors": [
      {
        "viewType": "secureNotes.editor",
        "displayName": "SecureNotes Preview",
        "selector": [
          {
            "filenamePattern": "*.enc.md"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vsc-secure-notes.encrypt",
          "when": "resourceExtname == .md && !(resourceFilename =~ /\\.enc\\.md$/)",
          "group": "navigation"
        },
        {
          "command": "vsc-secure-notes.decrypt",
          "when": "resourceFilename =~ /\\.enc\\.md$/",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Secure Notes",
      "properties": {
        "vsc-secure-notes.aesMode": {
          "type": "string",
          "default": "AES-GCM",
          "enum": [
            "AES-GCM",
            "AES-CTR",
            "AES-CBC"
          ],
          "description": "AES encryption modes."
        },
        "vsc-secure-notes.keySize": {
          "type": "number",
          "default": 256,
          "enum": [
            256,
            128
          ],
          "description": "AES key size in bits."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "markdown-it": "^14.1.1",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-task-lists": "^2.1.1"
  }
}
